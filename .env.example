# Biologix AI — environment variables
# Copy this file to .env and fill in your keys:
#
#   cp .env.example .env
#
# .env is gitignored. Never commit your real keys.

# ── Claude (required by the scientific pipeline) ──────────────────────────────
# The worker asks Claude to resolve the polymer repeat unit, choose the target
# structure and plan the synthesis evidence the retrosynthesis graph is built from.
# Each answer is then checked with RDKit, PubChem and the RCSB entry record. Without
# a key the worker falls back to its offline tables and marks every run incomplete.
ANTHROPIC_API_KEY=
BIOLOGIX_LLM_MODEL=claude-opus-5
BIOLOGIX_LLM_EFFORT=high
# Rounds the planner may use to answer the verification tools before giving up.
BIOLOGIX_LLM_RESOLVE_ROUNDS=3
BIOLOGIX_LLM_RETRO_ROUNDS=3
# Times the whole plan-then-build-the-graph loop is retried when the graph is empty.
BIOLOGIX_RETRO_PLAN_ATTEMPTS=2

# ── Optional: Semantic Scholar / Allen AI ─────────────────────────────────────
# Required only for the remote 'asta' MCP (literature search enhancement).
# Leave blank to use the built-in literature mining tools.
ASTA_API_KEY=

# Web platform
SECRET_KEY=replace-with-a-long-random-value
ADMIN_EMAILS=
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=biologix-artifacts
MINIO_ROOT_USER=biologix
MINIO_ROOT_PASSWORD=biologix-local-storage
SCIENTIFIC_RETROSYNTHESIS_ENABLED=true
SCIENTIFIC_OPENMM_ENABLED=true
BIOLOGIX_AI_OPENMM_PLATFORM=auto

# ── Physics sampling ──────────────────────────────────────────────────────────
# Interaction energy is averaged over a constant-pressure trajectory so it carries a
# spread. With sampling off it is one number off one minimised pose, which moves by
# hundreds of kJ/mol between runs and cannot rank candidates.
SCIENTIFIC_OPENMM_NPT=true
# 200 ps is where PEG/insulin converges (drift +13 kJ/mol vs a 41 kJ/mol spread); at
# 20 ps the energy was still falling and the mean was wrong by ~600 kJ/mol.
SCIENTIFIC_OPENMM_NPT_PS=200
SCIENTIFIC_OPENMM_WALL_CLOCK_S=3600
SCIENTIFIC_OPENMM_MINIMIZE_ITERATIONS=2000
# Frames the average has to be built from before the run counts as complete.
SCIENTIFIC_OPENMM_MIN_FRAMES=10
# Leading fraction of the trajectory treated as equilibration and left out of the mean.
BIOLOGIX_AI_OPENMM_MATRIX_EQUIL_FRACTION=0.5
# Wall clock for one experiment, and how long before an abandoned run is requeued.
EXPERIMENT_JOB_TIMEOUT_S=5400
STALE_JOB_MINUTES=105

# ── Docker build options ──────────────────────────────────────────────────────
# Set SLIM=1 to build a smaller image that downloads AiZynth models and the
# precursor database on first run instead of baking them in.
# SLIM=0

# ── Docker runtime CPU (optional) ─────────────────────────────────────────────
# scripts/docker_run.sh and scripts/docker_compose_run.sh set --cpus to 75% of
# host logical CPUs by default (optional macOS headroom). The image entrypoint
# always auto-detects container CPUs for OpenMM regardless of --cpus.
# Override host quota percent: DOCKER_CPU_PCT=100
# Override absolute quota: DOCKER_CPU_LIMIT=4
# In-container OpenMM fraction: BIOLOGIX_AI_EVAL_CPU_FRACTION=0.75
